;
; NodeToNodeVersionData, v16
;

nodeToNodeVersionData = [ networkMagic, initiatorOnlyDiffusionMode, peerSharing, query, perasSupport ]

; 32bit positive integer values
networkMagic = 0..2147483647
initiatorOnlyDiffusionMode = bool
; range between 0 and 1
peerSharing = 0..1
query = bool
perasSupport = bool

